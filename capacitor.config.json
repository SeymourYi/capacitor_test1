{
  "appId": "com.example.capacitor_test1",
  "appName": "capacitor_test1",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "allowNavigation": [
      "https://qianxunweimeng.cn:5361",
      "https://qianxunweimeng.cn:5361/*",
      "https://*",
      "http://*"
    ],
    "cleartext": true,
    "hostname": "localhost"
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": true,
    "appendUserAgent": "CapacitorApp/1.0",
    "overrideUserAgent": "Mozilla/5.0 (Linux; Android 10; SM-G975F) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.120 Mobile Safari/537.36 CapacitorApp/1.0",
    "webView": {
      "allowFileAccess": true,
      "allowContentAccess": true,
      "allowFileAccessFromFileURLs": true,
      "allowUniversalAccessFromFileURLs": true,
      "domStorageEnabled": true,
      "databaseEnabled": true,
      "geolocationEnabled": true,
      "javaScriptEnabled": true,
      "loadsImagesAutomatically": true,
      "mediaPlaybackRequiresUserGesture": false,
      "mixedContentMode": 0,
      "useWideViewPort": true,
      "supportMultipleWindows": false,
      "hardwareAccelerated": true
    },
    "permissions": [
      "android.permission.INTERNET",
      "android.permission.ACCESS_NETWORK_STATE",
      "android.permission.ACCESS_WIFI_STATE"
    ]
  }
}
